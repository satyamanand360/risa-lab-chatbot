# Required for the AI analyst: a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: Gemini model id. If empty, the app tries gemini-flash-latest, then newer Flash models in turn
GEMINI_MODEL=
# Optional: Postgres connection string (Neon, Supabase, Vercel Postgres). Without it the app uses an embedded database in .data/
DATABASE_URL=
